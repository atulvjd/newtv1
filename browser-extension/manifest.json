{
  "manifest_version": 3,
  "name": "Newtv1 Browser Companion",
  "version": "0.3.0",
  "description": "Preview a page or connect one tab for reviewed Newtv1 browser tasks.",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Connect a page to Newtv1" }
}
